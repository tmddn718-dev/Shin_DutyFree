# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다.
# 키를 비워 두면 그 제공자는 시연 모드(가짜 프로필)로 동작한다.

# 제공자 개발자 센터에 등록할 redirect URI 의 앞부분
# 등록할 주소 = PUBLIC_BASE_URL + /api/auth/{kakao|naver|google}/callback
PUBLIC_BASE_URL=http://localhost:8000

# 카카오: developers.kakao.com → 내 애플리케이션 → 앱 키(REST API 키), 보안(Client Secret, 사용할 때만)
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=

# 네이버: developers.naver.com → 애플리케이션 등록 (네이버 로그인)
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=

# 구글: console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID (웹 애플리케이션)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
